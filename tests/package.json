{
  "name": "@sculptcore/tests",
  "devDependencies": {
    "@litestl/typescript-runtime": "workspace:*",
    "@playwright/test": "^1.49.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "jest": "^30.3.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "type": "module",
  "scripts": {
    "test": "tsx wasmTest.ts",
    "test:debug": "tsx --inspect-brk wasmTest.ts",
    "test:webgpu": "playwright test --config webgpu/playwright.config.ts",
    "test:webgpu:update": "playwright test --config webgpu/playwright.config.ts --update-snapshots"
  },
  "packageManager": "pnpm@10.30.3",
  "workspaces": [
    "binding/typescriptRuntime"
  ]
}