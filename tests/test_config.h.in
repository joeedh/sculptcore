#pragma once

// Generated by CMake (configure_file) from test_config.h.in. Embeds build-time
// paths as string literals so tests need no command-line -D string defines
// (which the sccache launcher mangles on Windows).
//
// Resolved at RUNTIME with source-relative fallbacks: the cross-worktree
// sccache launcher normalizes worktree roots when hashing, so an object built
// in another worktree — with that worktree's absolute path baked in — can be
// served here as a cache hit. The probe keeps the assets reachable regardless
// of which root got baked.

#include <cstdio>

static inline const char *sculptcore_test_assets_dir()
{
  static const char *resolved = nullptr;
  if (resolved) {
    return resolved;
  }
  static const char *candidates[] = {
      "@SCULPTCORE_ASSETS_DIR_CMAKE@",
      "../../../tests/assets", // from build/native/tests (the ctest cwd)
      "../../tests/assets",    // from build/native
      "tests/assets",          // from the sculptcore root
  };
  for (const char *dir : candidates) {
    char probe[2048];
    std::snprintf(probe, sizeof(probe), "%s/AnimeGirl2.obj", dir);
    if (FILE *f = std::fopen(probe, "rb")) {
      std::fclose(f);
      resolved = dir;
      return resolved;
    }
  }
  resolved = "@SCULPTCORE_ASSETS_DIR_CMAKE@";
  return resolved;
}

#define SCULPTCORE_ASSETS_DIR sculptcore_test_assets_dir()
