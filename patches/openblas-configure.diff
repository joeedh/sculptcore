diff --git a/cmake/utils.cmake b/cmake/utils.cmake
index 8ede43f..f142628 100644
--- a/cmake/utils.cmake
+++ b/cmake/utils.cmake
@@ -369,6 +369,7 @@ function(GenerateNamedObjects sources_in)
 
   set(float_char "")
   set(OBJ_LIST_OUT "")
+  
   foreach (float_type ${float_list})
     foreach (source_file ${sources_in})
 
@@ -458,13 +459,18 @@ function(GenerateNamedObjects sources_in)
         set(old_source_file "${CMAKE_CURRENT_LIST_DIR}/${source_file}")
       endif ()
 
-      string(REPLACE ";" "\n#define " define_source "${obj_defines}")
-      string(REPLACE "=" " " define_source "${define_source}")
-      file(WRITE ${new_source_file}.tmp "#define ${define_source}\n#include \"${old_source_file}\"")
-      configure_file(${new_source_file}.tmp ${new_source_file} COPYONLY)
-      file(REMOVE ${new_source_file}.tmp)
+      # Wrapper is deterministic per build tree: write once, then record it in a
+      # per-file INTERNAL cache var so reconfigures skip the write (and mtime bump)
+      # without stat-ing it. The cache var *is* the existence record; wipe build dir to regen.
+      string(MD5 _gno_key "${new_source_file}")
+      if (NOT DEFINED GNO_CACHED_${_gno_key})
+        string(REPLACE ";" "\n#define " define_source "${obj_defines}")
+        string(REPLACE "=" " " define_source "${define_source}")
+        file(WRITE ${new_source_file} "#define ${define_source}\n#include \"${old_source_file}\"")
+        set(GNO_CACHED_${_gno_key} 1 CACHE INTERNAL "generated ${new_source_file}")
+      endif ()
       list(APPEND SRC_LIST_OUT ${new_source_file})
-      message (STATUS ${new_source_file})
+      #message (STATUS ${new_source_file})
       if (DEFINED HAVE_FMA3)
         if ( ${new_source_file} MATCHES "(s|d?)rot_k.*c")
 		set_source_files_properties(${new_source_file} PROPERTIES COMPILE_OPTIONS "-mfma")
