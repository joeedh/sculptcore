export default {
  CMAKE_BUILD_TYPE: 'RelWithDebInfo',
  CMAKE_GENERATOR: 'Ninja',
  WITH_ASAN: false,

  /** Build native + node-addon with MSVC (cl.exe) instead of clang. Uses its own
   *  build dirs (build/native-msvc, build/native-node-msvc) so it never clashes
   *  with a clang tree. Compatible with WITH_ASAN. */
  WITH_NATIVE_MSVC: false,

  /** note: you must run ./extern/fetch_abseil.sh to clone abseil */
  WITH_MESHLOG_ABSEIL_HASHMAP: false,
}