// Kelvinlet — soft-body grab with a regularized point-force solution to
// the linear elasticity equations (de Goes & James, 2017). Pulls a region
// of the surface from `grabFrom` toward `grabTo`, with the falloff shape
// determined by the brush radius (used as the regularization epsilon)
// and the material constants mu (shear modulus) and nu (Poisson ratio).
//
// Wave 4 slice: introduces the DSL's `reduce` stage so the per-stroke
// material coefficients are computed once instead of per-vertex; the
// reduce output is passed into `apply` as value params. Pose brushes
// (which need BVH queries) wait for Wave 4b.

@brush("kelvinlet")
@tool KELVINLET
@gpu
@unbounded
@grabmode
brush Kelvinlet {
  // Material parameters near "soft rubber" (mu=1, nu=0.4); higher mu =
  // stiffer falloff, nu near 0.5 = nearly incompressible. The `@range`s
  // mirror the clampParams bounds below so a device-driven value stays in
  // the well-defined region. `radius` is declared so the DSL can name it
  // directly as the regularization epsilon (the field already exists on
  // Brush; this just opts it in to identifier resolution).
  uniform float mu = 1.0 @range(1e-6, 100.0);
  uniform float nu = 0.4 @range(0.0, 0.499);
  uniform float radius;

  // Stroke state set by `set_grab` before the dab. Both live on Brush
  // (so DSL `ctx float3 X` would emit `ctx.brush.X`, which is exactly
  // what we want here).
  ctx float3 grabFrom, grabTo;
  // Brush-center surface normal, needed only as sampleBrushTex's `no` arg.
  ctx float3 surfaceNo;

  // Host stage runs once per dab on the CPU before any per-node work.
  // For kelvinlet, the only thing host needs to do is keep mu/nu inside
  // the range where the reduce-stage math stays well-defined: the declared
  // nu domain keeps `4 * (1 - nu)` positive, and mu near zero blows up the
  // `(1+nu)/(2*mu)` factor. Clamping here means downstream stages (on
  // any backend) consume sanitized values without having to repeat the
  // check per-vertex. Default mu=1.0, nu=0.4 are inside the range, so
  // this is a no-op for the regression script.
  host void clampParams() {
    if (nu > 0.499) nu = 0.499;
    if (nu < 0.0) nu = 0.0;
    if (mu < 1e-6) mu = 1e-6;
  }

  // Two scalar `out` reduce outputs — `a` and `b` are the kelvinlet
  // coefficients derived from mu/nu. The vertex stage receives them as
  // `in float` params, matched by name.
  reduce void prep(out float a, out float b) {
    a = (1.0 + nu) / (2.0 * mu);
    b = a / (4.0 * (1.0 - nu));
  }

  vertex void apply(inout Vertex v, in float a, in float b) {
    if (radius <= 0.0) { continue; }
    float window = unbounded_window(v.co);
    if (window == 0.0) { continue; }
    float forceScale = max(max(abs(grabTo.x), abs(grabTo.y)), abs(grabTo.z));
    if (forceScale == 0.0) { continue; }
    float3 p = v.co;
    float3 r = p - grabFrom;
    float eps = radius;
    // Only large offsets need halving before subtraction. Keeping ordinary
    // offsets unscaled avoids introducing subnormal half-radii at the origin.
    float maxR = max(max(abs(r.x), abs(r.y)), abs(r.z));
    if (maxR > 1e30) {
      r = p * 0.5 - grabFrom * 0.5;
      eps = radius * 0.5;
    }
    float rawNorm = 1.5 * a - b;
    float norm = max(rawNorm, 1e-6);
    float originGain = rawNorm / norm;
    float3 disp = grabTo * originGain;
    if (r.x != 0.0 || r.y != 0.0 || r.z != 0.0) {
      float scale = max(max(abs(r.x), abs(r.y)), max(abs(r.z), eps));
      float3 scaledR = r / scale;
      float scaledEps = eps / scale;
      float e = sqrt(dot(scaledR, scaledR) + scaledEps * scaledEps);
      float3 q = scaledR / e;
      float t = scaledEps / e;
      // Formula (6), normalized using dimensionless distance/radius ratios.
      // This removes radius squared and inverse-distance cubed intermediates.
      float isotropic = t * (originGain - (0.5 * a / norm) * (1.0 - t * t));
      float anisotropic = b / norm * t;
      float3 force = grabTo / forceScale;
      float3 contracted = force * isotropic + q * (dot(force, q) * anisotropic);
      // In the declared material domain the field's absolute row sums are <= 1.
      // Enforce that bound before restoring scale: near-origin rounding can
      // otherwise produce one excess ulp and overflow a finite FLT_MAX force.
      contracted = float3(clamp(contracted.x, -1.0, 1.0),
                          clamp(contracted.y, -1.0, 1.0),
                          clamp(contracted.z, -1.0, 1.0));
      disp = contracted * forceScale;
    }
    // Excluded vertices never sample textures or contribute affected-vertex
    // bookkeeping. The field origin remains independent of the window center.
    v.co += disp * (masks() * window * sampleBrushTex(v.co, surfaceNo));
  }
}
