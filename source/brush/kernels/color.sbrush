// Color paint — lerp a per-vertex color layer toward the brush color by brush
// strength*falloff (mask-gated). Blend modes and per-corner colors arrive in
// a later paint-brush wave.
@brush("color")
@paint
brush Color {
  attr vertex float4 color;
  // Paint color, synced from the TS brush (brush.color) per stroke.
  uniform float4 brushColor;
  // Undo captures the color layer only (paint moves no geometry).
  save vertex color;

  vertex void apply(inout Vertex v) {
    float s = strength(v.co) * (1.0 - v.mask);
    if (s == 0.0) { continue; }
    v.color = v.color + (brushColor - v.color) * s;
  }
}
