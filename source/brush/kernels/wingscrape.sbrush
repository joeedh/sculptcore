// Wing Scrape — like Scrape, but two stroke-aligned 'wing' planes that meet at
// the stroke line. Each vertex is projected down onto the wing on its own
// lateral side, so the pair scrapes a shallow roof: the cut deepens away from
// the stroke line and leaves a sharp convex crease running along it.
//
// The two wing normals are surfaceNo rotated ∓wingAngle about the stroke
// tangent (strokeDir). They are recomputed once per dab in the `host` stage
// (Rodrigues rotation) and read per-vertex. `strokeDir` is set host-side by
// the executor before the dab; `wingAngle` comes from the brush. The apex
// ridge is sunk `planeoff * radius` below the surface point so the brush bites
// into a flat face, as Scrape does.
//
// A degenerate strokeDir (parallel to surfaceNo — the very first dab of a
// stroke, before a tangent exists) collapses both wings onto surfaceNo, which
// falls back to a plain flat scrape rather than a no-op.

@brush("wingscrape")
@tool WINGSCRAPE
brush WingScrape {
  ctx float3 surfacePos;
  ctx float3 surfaceNo;
  ctx float3 strokeDir;
  ctx float3 wingNormalA, wingNormalB;
  uniform float wingAngle @static;
  uniform float planeoff, radius;

  // Compute the two wing-plane normals once per dab: surfaceNo rotated
  // ∓wingAngle about the (normalized) stroke tangent, via Rodrigues' formula
  //   V*cos + (K×V)*sin + K*(K·V)*(1-cos).
  host void computeWings() {
    float3 K = normalize(strokeDir);
    float3 V = surfaceNo;
    float c = cos(wingAngle);
    float sn = sin(wingAngle);
    float3 KxV = cross(K, V);
    float kv = dot(K, V);
    // Each wing leans TOWARD its own lateral side (lat = cross(V, K) = -KxV),
    // so the planes tent up over the stroke line. Leaning them the other way
    // makes the pair a valley and the brush gouges a channel instead.
    wingNormalA = V * c - KxV * sn + K * (kv * (1.0 - c));
    wingNormalB = V * c + KxV * sn + K * (kv * (1.0 - c));
  }

  vertex void apply(inout Vertex v) {
    float s = strength(v.co) * masks();
    if (s == 0.0) {
      continue;
    }
    // Both wings meet at a line `planeoff * radius` below the surface point
    // (planeoff < 0), exactly like plane.sbrush's Scrape. With the apex left on
    // the surface nothing on a flat face is ever above a wing and the brush is
    // a no-op — that was the "wing scrape does nothing" bug.
    float3 P = surfacePos + surfaceNo * (planeoff * radius);
    // Lateral axis: perpendicular to the stroke, in the tangent plane. Its sign
    // picks which wing this vertex belongs to.
    float3 lat = cross(surfaceNo, strokeDir);
    float side = dot(v.co - P, lat);
    float3 wn = wingNormalB;
    if (side > 0.0) {
      wn = wingNormalA;
    }
    // Project verts above the chosen wing plane down onto it — a scrape into
    // the wing.
    float h = dot(v.co - P, wn);
    if (h > 0.0) {
      v.co -= wn * (h * s);
    }
  }
}
