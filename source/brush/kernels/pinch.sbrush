// Pinch — pull each vert toward the brush center (surfacePos),
// proportional to falloff*strength and gated by mask.

@brush("pinch")
@tool PINCH
@gpu
brush Pinch {
  ctx float3 surfacePos;
  uniform float radius;
  // Pinch amount (0..1), synced from the TS brush (brush.pinch); scales the
  // toward-center pull so the brush setting actually drives the effect.
  uniform float pinch @static;

  vertex void apply(inout Vertex v) {
    float s = strength(v.co) * masks() * pinch;
    if (s == 0.0) {
      continue;
    }
    float3 dir = surfacePos - v.co;
    float d = length(dir);
    // Move toward the center by a fixed s*radius/2 step, but never by more than
    // fraction `s` of the distance that is actually left — otherwise verts near
    // the center overshoot and cross to the far side. Guard div-by-zero for the
    // lone vert that may sit exactly at surfacePos.
    if (d > 0.0001) {
      float t = min(s * radius * 0.5 / d, min(s, 1.0));
      v.co += dir * t;
    }
  }
}
