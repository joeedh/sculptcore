// Pinch / Magnify — gather verts onto the stroke line (pinch), or, inverted,
// push them away from it (magnify). The port of Blender's do_pinch_brush:
// the vert's offset toward the brush centre is kept only in the in-plane
// direction *across* the stroke and along the surface normal; the component
// along the stroke direction is dropped, so a stroke pinches a ridge into
// existence along its path instead of collapsing everything onto the dab
// centre. Each vert moves by the fraction `strength x falloff` of that
// offset; `pinch` scales it (the host hands it the brush strength, which
// squares the slider the way Blender's `brush_strength` does), and an
// inverted (magnify) dab runs at a quarter strength, as Blender's does.
//
// The first dab of a stroke has no direction yet (`strokeDir` is zero); it
// gathers toward the point instead.

@brush("pinch")
@tool PINCH
@gpu
brush Pinch {
  ctx float3 surfacePos;
  ctx float3 surfaceNo;
  ctx float3 strokeDir;
  uniform float radius;
  // Pinch amount, synced from the host brush (brush.pinch); scales the
  // toward-line pull so the brush setting actually drives the effect.
  uniform float pinch @static;

  vertex void apply(inout Vertex v) {
    float s = strength(v.co) * masks() * pinch;
    if (s == 0.0) {
      continue;
    }
    if (s < 0.0) {
      s *= 0.25;
    }
    // Never past the line: a fraction above 1 would cross it.
    if (s > 1.0) {
      s = 1.0;
    }
    float3 d = surfacePos - v.co;
    float3 across = cross(surfaceNo, strokeDir);
    float al = length(across);
    float3 t = d;
    if (al > 0.0001) {
      across = across / al;
      t = across * dot(d, across) + surfaceNo * dot(d, surfaceNo);
    }
    v.co += t * s;
  }
}
