// Boundary-aware smooth (boundary.md). A boundary vertex — one whose lazily
// recomputed .boundary.vert.class bitmask is non-zero — averages only the
// neighbors that share its dominant boundary type. SHARP overrides the smooth
// types (projected/seam/poly/uv): a sharp crease vertex averages only its
// like-crease neighbors and gets the same volume-preserving normal flatten as an
// interior vertex, so the crease smooths along itself as a clean discontinuity
// (the surface never averages across it). A projected/seam/etc. vertex instead
// projects fully into the surface tangent plane (the curve relaxes but stays on
// the surface). A chain *endpoint* (BC_ENDPOINT — one dominant-type edge) relaxes
// like an interior vertex so the chain end follows the surface instead of
// collapsing onto its single neighbor. Interior verts (class 0) smooth normally,
// so this reduces to plain Laplacian smoothing when no boundaries are marked.
//
// Consumers must run boundary::recomputeDirty before the stroke so vclass is
// current. UV slide-reprojection and the corner (>=3 junction) special case are
// follow-ups; GPU dispatch of the vclass attr is wired separately (CPU for now).
@brush("bsmooth")
brush BSmooth {
  attr vertex int vclass = ".boundary.vert.class";
  // Volume-preservation projection (0..1), synced from the TS brush
  // (brush.smoothProj). Interior verts remove this fraction of the smoothing
  // step's normal component, so the surface slides tangentially instead of
  // shrinking. Boundary verts always fully project (they must stay put).
  uniform float projection @static;

  vertex void apply(inout Vertex v) {
    float s = strength(v.co) * (1.0 - v.mask);
    if (s == 0.0) { continue; }

    int vc = v.vclass;
    // dom = the single bit (or smooth-type bits) that gates neighbors. SHARP
    // wins; an endpoint drops its constraint and relaxes like an interior vert.
    int dom = vc & 31;          // BC_TYPE_MASK

    float3 tangentDisp = float3(0.0, 0.0, 0.0);
    float3 normalDisp = float3(0.0, 0.0, 0.0);

    float nTan = 0.0;
    float nProj = 0.0;
    float wNor = 1.0;
    float wTan = 1.0;

    if ((vc & 2) != 0) {
      // BC_SHARP overrides smooth types
      wNor = 0.0;
    }
    if ((vc & 32) != 0) { 
      // BC_ENDPOINT relaxes (all neighbors)
      wTan = 0.0;
      wNor = 1.0;
    }  

    for_neighbor (nb in v) {
      float wTan2 = wTan;
      if (dom != 0) {
        // zero out tangent displacement
        if ((dom & nb.vclass) == 0) { wTan2 = 0.0; }
      }

      float3 disp = nb.co - v.co;
      float3 normalPart = (v.no * dot(disp, v.no));

      normalDisp += normalPart * wNor;
      tangentDisp += (disp - normalPart) * wTan2;

      nTan = nTan + wTan2;
      nProj = nProj + wNor;
    }

    float3 disp = float3(0.0, 0.0, 0.0);
    if (nTan > 0.0) {
      disp += tangentDisp / nTan;
    }
    if (nProj > 0.0) {
      disp += normalDisp / nProj * (1.0 - projection);
    }
    v.co += disp * s;
  }
}
