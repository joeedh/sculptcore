// Boundary-aware smooth (boundary.md). A neighbor's displacement is split into a
// normal part (along the vertex normal) and a tangential part, weighted by
// wNor/wTan from the lazily recomputed .boundary.vert.class bitmask. Class 0
// (interior) is plain Laplacian smoothing that removes a `projection` fraction of
// the normal component (volume-preserving tangential slide), so this reduces to
// ordinary smoothing when no boundaries are marked. The boundary cases:
//
//   * SHARP crease: average only like-(sharp) neighbors and drop the normal
//     component entirely (wNor=0) — the vertex slides purely along the crease
//     tangent, so the crease smooths along itself as a clean discontinuity (the
//     surface never averages across it and never bulges).
//   * Smooth boundary (projected/seam/poly/uv): average only like-type neighbors
//     tangentially but keep the interior (1-projection) normal motion from all
//     neighbors, so the curve relaxes while still following the surface.
//   * Chain endpoint (BC_ENDPOINT): drop the tangential slide (wTan=0) — there is
//     one like-neighbor and averaging toward it would collapse the end — and keep
//     only normal motion so the end follows the surface. SHARP wins over a smooth
//     type on the same vertex (treated as sharp: wNor=0).
//   * Corner (BC_JUNCTION, >=3 feature edges): a sharp junction (e.g. a cube
//     corner) is pinned entirely — any motion erodes it. A smooth-type junction
//     (e.g. a UV-chart corner) gets the endpoint treatment: normal-only motion,
//     so the corner follows the surface instead of freezing in place.
//
// Consumers must run boundary::recomputeDirty before the stroke so vclass is
// current. GPU dispatch of the vclass attr is wired separately (CPU for now).
@brush("bsmooth")
@relaxation
brush BSmooth {
  attr vertex int vclass = ".boundary.vert.class";
  // Volume-preservation projection (0..1), synced from the TS brush
  // (brush.smoothProj). Interior verts remove this fraction of the smoothing
  // step's normal component, so the surface slides tangentially instead of
  // shrinking. Boundary verts always fully project (they must stay put).
  uniform float projection @static;

  vertex void apply(inout Vertex v) {
    float s = strength(v.co) * (1.0 - v.mask);
    if (s == 0.0) { continue; }

    int vc = v.vclass;
    if ((vc & 128) != 0 && (vc & 2) != 0) {
      // Sharp BC_JUNCTION (>=3 feature edges, e.g. a cube corner): pin
      // entirely — any averaging erodes the corner.
      continue;
    }
    // dom = the boundary-type bits (BC_TYPE_MASK) that gate which neighbors enter
    // the tangential average; never narrowed to a single bit.
    int dom = vc & 31;

    float3 tangentDisp = float3(0.0, 0.0, 0.0);
    float3 normalDisp = float3(0.0, 0.0, 0.0);

    float nTan = 0.0;
    float nProj = 0.0;
    float wNor = 1.0;
    float wTan = 1.0;

    if ((vc & 2) != 0) {
      // BC_SHARP: drop the normal component → slide purely along the crease
      wNor = 0.0;
    }
    if ((vc & 160) != 0) {
      // BC_ENDPOINT (32) or smooth-type BC_JUNCTION (128, e.g. a UV-chart
      // corner): drop the tangential slide (averaging would collapse the end /
      // erode the corner), keep only normal motion to follow the surface
      wTan = 0.0;
      wNor = 1.0;
    }

    for_neighbor (nb in v) {
      float wTan2 = wTan;
      if (dom != 0) {
        // zero out tangent displacement
        if ((dom & nb.vclass) == 0) { wTan2 = 0.0; }
      }

      float3 disp = nb.co - v.co;
      float3 normalPart = (v.no * dot(disp, v.no));

      normalDisp += normalPart * wNor;
      tangentDisp += (disp - normalPart) * wTan2;

      nTan = nTan + wTan2;
      nProj = nProj + wNor;
    }

    float3 disp = float3(0.0, 0.0, 0.0);
    if (nTan > 0.0) {
      disp += tangentDisp / nTan;
    }
    if (nProj > 0.0) {
      disp += normalDisp / nProj * (1.0 - projection);
    }
    v.co += disp * s;
  }
}
