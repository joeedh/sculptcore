// Draw — push the surface along the surface normal proportional to
// brush strength * falloff(distance to center).
//
// Wave 1: source-level rewrite of source/brush/brushes/draw.h. The
// strength/falloff computation stays inside CommandCtx::strength(co)
// (exposed as the `strength` intrinsic), so behavior matches the
// hand-written kernel byte-for-byte. Wave 2 inlines the falloff into
// the IR so non-C++ backends can lower it.

@brush("draw")
brush Draw {
  ctx float3 surfaceNo;

  vertex void apply(inout Vertex v) {
    float s = strength(v.co);
    // Brush-texture modulation. With no texture bound, sampleBrushTex
    // returns 1.0, so this leaves the falloff strength bit-identical.
    s *= sampleBrushTex(v.co, surfaceNo);
    if (s == 0.0) {
      continue;
    }
    v.co += surfaceNo * s;
  }
}
