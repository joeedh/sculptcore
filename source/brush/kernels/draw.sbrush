// Draw — push the surface along the surface normal proportional to
// brush strength * falloff(distance to center).

@brush("draw")
brush Draw {
  ctx float3 surfaceNo;
  uniform float radius;

  vertex void apply(inout Vertex v) {
    float s = strength(v.co) * (1.0 - v.mask);
    // Brush-texture modulation. With no texture bound, sampleBrushTex
    // returns 1.0, so this leaves the falloff strength bit-identical.
    s *= sampleBrushTex(v.co, surfaceNo);
    if (s == 0.0) {
      continue;
    }
    v.co += surfaceNo * s * radius * 0.5;
  }
}
