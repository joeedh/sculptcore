// Grab — drag the region under the dab by the CUMULATIVE cursor displacement
// (`grabTo` = cursor − stroke anchor), gated by falloff*strength and the mask
// layer. Grab-class (#35): the executor runs it from each vert's stroke-start
// position (AccumOrigGrab), so re-applying a grown `grabTo` re-bases instead
// of stacking; the TS bridge anchors the dab center (see
// SculptPaintOp.applyDabOne) and the executor pins the node region for the
// stroke (CommandExecutor::grabFilterNodes). @grabmode gives the WGSL leg the
// same from-orig + per-dab first-touch write-back.

@brush("grab")
@grabmode
brush Grab {
  ctx float3 grabTo;
  uniform float radius;

  vertex void apply(inout Vertex v) {
    float fall = strength(v.co) * masks();
    if (fall == 0.0) {
      continue;
    }
    v.co += grabTo * fall;
  }
}
