// Pose brush — 4-anchor soft-attraction. Each anchor `poseCageRest[i]`
// pulls nearby verts toward `poseCageNow[i]` with weight 1/(1+|d|²);
// the per-vertex displacement is the weight-normalized sum. Inverse-
// distance falloff means the closest anchor dominates without any
// hard cutoff — gives a smooth posing feel without needing a BVH for
// rigid-region partitioning (that's a later slice).
//
// Wave 4b slice: introduces the DSL's `Array<T, N>` field type plus
// subscript expressions, so the per-anchor stanzas can be written
// against indexed cage state instead of four scalar fields. A small
// `for` loop walks the four anchors — four is enough for a pose
// (pin one limb, pivot another) and stays cheap in the kernel.

@brush("pose")
@tool POSE
@gpu
brush Pose {
  uniform float strength, radius;

  // Cage anchors live on Brush (set by script verbs before each dab);
  // the `ctx Array<float3, 4>` form opts both arrays into DSL
  // identifier resolution and reserves matching slots in the WGSL
  // CtxUniforms block for a future GPU dispatch.
  ctx Array<float3, 4> poseCageRest, poseCageNow;

  vertex void apply(inout Vertex v) {
    float3 disp = float3(0.0, 0.0, 0.0);
    float wsum = 0.0;

    for (int i = 0; i < 4; i += 1) {
      float3 d = v.co - poseCageRest[i];
      float w = 1.0 / (1.0 + dot(d, d));
      disp += (poseCageNow[i] - poseCageRest[i]) * w;
      wsum += w;
    }

    if (wsum > 0.000001) {
      float fall = strength(v.co) * masks();
      v.co += (disp / wsum) * fall;
    }
  }
}
