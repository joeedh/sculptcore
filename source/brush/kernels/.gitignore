# Ignore everything sbrushc drops into generated/ EXCEPT the checked-in C++
# brush kernel headers (*.brush.gen.h), the texture-unit headers
# (*.tex.gen.h) and the texture registry. Those are committed so
# cross-compile builds (WASM/CI) can consume them without building the native
# sbrushc host tool — see sbrushCodegen() in make.mjs (SBRUSH_SKIP_NATIVE_CODEGEN).
/generated/*
!/generated/*.brush.gen.h
!/generated/*.tex.gen.h
!/generated/sculptcore_textures.gen.h
