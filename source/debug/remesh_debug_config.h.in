#pragma once

// Generated by CMake (configure_file) from remesh_debug_config.h.in. Embeds
// build-time absolute paths + git commit as string literals (no -D string
// defines, which the sccache launcher mangles on Windows). REMESH_DBG_CLI_PATH
// is the cli's own build output, so rebuilding just `remesh_cli` (while the app
// runs) is picked up on the next run; the app falls back to its own-dir copy
// when that path is gone (a deployed/moved app).
#define REMESH_DBG_GIT_COMMIT  "@REMESH_DBG_GIT_COMMIT@"
#define REMESH_DBG_ASSETS_DIR  "@REMESH_DBG_ASSETS_DIR@"
#define REMESH_DBG_RESULTS_DIR "@REMESH_DBG_RESULTS_DIR@"
#define REMESH_DBG_TOOLS_DIR   "@REMESH_DBG_TOOLS_DIR@"
#define REMESH_DBG_KEYS_DIR    "@REMESH_DBG_KEYS_DIR@"
#define REMESH_DBG_CLI_PATH    "@REMESH_DBG_CLI_PATH@"
