# Tool version pins for the sbrush brush-backend CI image.
# Sourced by ci/Dockerfile.brush-backends and by make.mjs sbrush-validate.
# Update here, rebuild the image, no other files need to change.

# Host toolchain
LLVM_VERSION=18
NODE_VERSION=24.14.0
PNPM_VERSION=10.30.3

# WASM (must match ../emsdkVersion.txt; checked at image build time)
EMSDK_VERSION=4.0.18

# WGSL: Dawn standalone build of tint
# Pinned by commit; bump when WGSL spec changes are needed.
TINT_COMMIT=b975919dfb45406ca17162e4d44c74a650caa679

# SPIR-V
# Khronos pins SPIRV-Tools by the Vulkan SDK release it ships with.
# Format: vulkan-sdk-<major>.<minor>.<patch>.<build>; tag must exist at
# https://github.com/KhronosGroup/SPIRV-Tools/tags
SPIRV_TOOLS_VERSION=1.4.350.0
GLSLANG_VERSION=14.3.0

# CUDA (headers + nvcc, no driver needed for --cuda --dryrun)
CUDA_VERSION=12.6.2

# HIP / ROCm (syntax-only hipcc, no AMD driver needed)
ROCM_VERSION=6.4.2

# OpenCL
# clspv has no release tags — pin to a known-good commit on main.
# Bump by inspecting https://github.com/google/clspv/commits/main
CLSPV_COMMIT=24e7e4f6b3652ef005dd4990fbc7b64aa2be0d5f
POCL_VERSION=6.0
